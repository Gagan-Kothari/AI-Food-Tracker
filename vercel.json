{
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" },
    { "src": "frontend2/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot))", "dest": "frontend2/dist/$1" },
    { "src": "/(.*)", "dest": "frontend2/dist/index.html" }
  ]
}

