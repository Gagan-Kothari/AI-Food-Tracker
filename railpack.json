{
  "provider": "python",
  "packages": {
    "python": "3.13"
  },
  "phases": {
    "install": {
      "cmds": [
        "pip install --upgrade pip",
        "pip install -r requirements.txt"
      ]
    }
  },
  "start": {
    "command": "python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}

